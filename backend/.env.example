# ── NODE ENV ───────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Base de datos ──────────────────────────────────────────────────────────
# En producción (Railway) usar DATABASE_URL. En dev, las variables individuales.
# DATABASE_URL=postgres://user:pass@host:5432/db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=caso_listo

# ── JWT (REQUERIDOS — ≥32 chars, distintos entre sí) ───────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplazar-por-un-secreto-fuerte-de-al-menos-32-chars
JWT_REFRESH_SECRET=reemplazar-por-un-segundo-secreto-distinto-de-al-menos-32-chars

# ── CORS ───────────────────────────────────────────────────────────────────
# Lista separada por comas de orígenes autorizados (full URL). Requerido en prod.
ALLOWED_ORIGINS=http://localhost:3000

# ── Cookies ────────────────────────────────────────────────────────────────
# Opcional. Para compartir entre subdominios: COOKIE_DOMAIN=.casolisto.online
# COOKIE_DOMAIN=

# ── Proxy ──────────────────────────────────────────────────────────────────
# Lista separada por comas de IPs / subredes de proxies confiables. Si se deja
# vacío, confiamos en exactamente 1 hop (suficiente para Railway).
# TRUSTED_PROXIES=

# ── Email (Resend) ─────────────────────────────────────────────────────────
# Generar la API key en https://resend.com/api-keys. Si no está seteada, los
# emails se omiten silenciosamente (útil para dev local).
RESEND_API_KEY=
# Remitente — debe ser un dominio verificado en Resend.
MAIL_FROM=Caso Listo <noreply@casolisto.online>

# ── Frontend ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3001
